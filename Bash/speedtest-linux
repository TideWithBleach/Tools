#!/bin/bash

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

echo -e "${CYAN}========================================"
echo -e "${CYAN}Azure Local Network Speed Test"
echo -e "${CYAN}========================================${NC}"
echo ""
echo -e "${GRAY}This script tests your internet connection by downloading a 100MB test file"
echo -e "${GRAY}and validates if it meets the bandwidth requirements for Azure Local deployment."
echo -e "${GRAY}Recommended minimum: 20 Mbps (Microsoft minimum: 10 Mbps)${NC}"
echo ""
echo -e "${GRAY}For bandwidth requirements, see:${NC}"
echo -e "${CYAN}https://learn.microsoft.com/en-us/azure/azure-local/concepts/system-requirements-disaggregated${NC}"
echo ""

# Proxy selection
echo -e "${CYAN}Select a proxy option:${NC}"
echo -e "${GRAY}1. http://pzen.fpl.com:10262${NC}"
echo -e "${GRAY}2. http://lcpzen.fpl.com:10262${NC}"
echo -e "${GRAY}3. http://gopzen.fpl.com:10262${NC}"
echo -e "${GRAY}4. No proxy${NC}"
echo -e "${GRAY}5. Enter a custom proxy${NC}"
read -p "Enter your choice (1-5): " choice

case $choice in
    1) PROXY="http://pzen.fpl.com:10262" ;;
    2) PROXY="http://lcpzen.fpl.com:10262" ;;
    3) PROXY="http://gopzen.fpl.com:10262" ;;
    4) PROXY="" ;;
    5) 
        read -p "Enter custom proxy URL (e.g., http://proxy.example.com:8080): " PROXY
        ;;
    *) 
        echo -e "${YELLOW}Invalid choice. Using no proxy.${NC}"
        PROXY=""
        ;;
esac

# Thread selection
echo ""
echo -e "${CYAN}Select number of parallel connections:${NC}"
echo -e "${GRAY}1. 1 connection (single-threaded)${NC}"
echo -e "${GRAY}2. 4 connections (default, recommended)${NC}"
echo -e "${GRAY}3. Custom number${NC}"
read -p "Enter your choice (1-3): " thread_choice

case $thread_choice in
    1) THREADS=1 ;;
    2) THREADS=4 ;;
    3) 
        read -p "Enter number of connections (1-16): " custom_threads
        if [[ $custom_threads =~ ^[0-9]+$ ]] && [ $custom_threads -ge 1 ] && [ $custom_threads -le 16 ]; then
            THREADS=$custom_threads
        else
            echo -e "${YELLOW}Invalid number. Using 4 connections.${NC}"
            THREADS=4
        fi
        ;;
    *) 
        echo -e "${YELLOW}Invalid choice. Using 4 connections.${NC}"
        THREADS=4
        ;;
esac

URL="https://files.hexaqa.com/size/100mb.bin"
TEMP_DIR="/tmp"
OUTFILE="$TEMP_DIR/100mb.bin"

# Get hostname and IP
HOSTNAME=$(hostname)
IP_ADDRESS=$(hostname -I | awk '{print $1}')

if [ -n "$PROXY" ]; then
    echo -e "${CYAN}Downloading test file through proxy: $PROXY${NC}"
    echo -e "${GRAY}Hostname: $HOSTNAME | IP: $IP_ADDRESS${NC}"
else
    echo -e "${CYAN}Downloading test file (no proxy)...${NC}"
    echo -e "${GRAY}Hostname: $HOSTNAME | IP: $IP_ADDRESS${NC}"
fi

echo -e "${GRAY}Using $THREADS parallel connections...${NC}"
echo ""

# Start timer
START_TIME=$(date +%s.%N)

# Download in parallel
TOTAL_BYTES=0
for ((i=0; i<THREADS; i++)); do
    TEMP_FILE="$TEMP_DIR/100mb_$i.bin"
    
    if [ -n "$PROXY" ]; then
        curl -s -x "$PROXY" -o "$TEMP_FILE" "$URL" &
    else
        curl -s -o "$TEMP_FILE" "$URL" &
    fi
    
    PIDS[$i]=$!
done

# Wait for all downloads with progress
COMPLETED=0
while [ $COMPLETED -lt $THREADS ]; do
    COMPLETED=0
    for pid in "${PIDS[@]}"; do
        if ! kill -0 "$pid" 2>/dev/null; then
            ((COMPLETED++))
        fi
    done
    PERCENT=$((COMPLETED * 100 / THREADS))
    echo -ne "\r${CYAN}Multi-threaded download in progress${NC} - Completed $COMPLETED of $THREADS connections ($PERCENT%)"
    sleep 0.2
done
echo ""

# Wait for all processes to finish
wait

END_TIME=$(date +%s.%N)

# Calculate total bytes
for ((i=0; i<THREADS; i++)); do
    TEMP_FILE="$TEMP_DIR/100mb_$i.bin"
    if [ -f "$TEMP_FILE" ]; then
        BYTES=$(stat -c%s "$TEMP_FILE" 2>/dev/null || echo 0)
        TOTAL_BYTES=$((TOTAL_BYTES + BYTES))
        rm -f "$TEMP_FILE"
    fi
done

# Calculate speed
ELAPSED=$(echo "$END_TIME - $START_TIME" | bc)
MBPS=$(echo "scale=2; ($TOTAL_BYTES * 8) / $ELAPSED / 1000000" | bc)

echo ""
echo -e "${CYAN}Bytes Downloaded: $TOTAL_BYTES (connections: $THREADS)${NC}"

# Format elapsed time
ELAPSED_INT=${ELAPSED%.*}
if [ $ELAPSED_INT -ge 3600 ]; then
    HOURS=$((ELAPSED_INT / 3600))
    MINUTES=$(((ELAPSED_INT % 3600) / 60))
    SECONDS=$((ELAPSED_INT % 60))
    TIME_STRING="${HOURS}h ${MINUTES}m ${SECONDS}s"
elif [ $ELAPSED_INT -ge 60 ]; then
    MINUTES=$((ELAPSED_INT / 60))
    SECONDS=$((ELAPSED_INT % 60))
    TIME_STRING="${MINUTES}m ${SECONDS}s"
else
    TIME_STRING="${ELAPSED}s"
fi
echo -e "${CYAN}Elapsed Time: $TIME_STRING${NC}"

echo -e "${YELLOW}Download Speed (Mbps): $MBPS${NC}"

MINIMUM_MBPS=10
RECOMMENDED_MBPS=20

# Compare using bc for floating point
PASS=$(echo "$MBPS >= $RECOMMENDED_MBPS" | bc)
WARNING=$(echo "$MBPS >= $MINIMUM_MBPS" | bc)

if [ "$PASS" -eq 1 ]; then
    echo -e "${GREEN}Result: PASS - Speed of $MBPS Mbps meets Microsoft minimum ($MINIMUM_MBPS Mbps) and recommended ($RECOMMENDED_MBPS Mbps)${NC}"
elif [ "$WARNING" -eq 1 ]; then
    echo -e "${YELLOW}Result: WARNING - Speed of $MBPS Mbps meets Microsoft minimum ($MINIMUM_MBPS Mbps) but is less than the recommended ($RECOMMENDED_MBPS Mbps)${NC}"
else
    echo -e "${RED}Result: FAIL - Speed of $MBPS Mbps is below both Microsoft minimum ($MINIMUM_MBPS Mbps) and recommended ($RECOMMENDED_MBPS Mbps)${NC}"
fi
